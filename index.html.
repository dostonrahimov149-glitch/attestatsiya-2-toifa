<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#12345a"><title>AttestFLE — Mock test</title><style>
:root{--navy:#12345a;--blue:#235a91;--gold:#c59b42;--bg:#f3f6fa;--ink:#17283c;--muted:#66758a;--line:#dce4ee;--green:#18794e;--red:#b42318}*{box-sizing:border-box}body{margin:0;background:var(--bg);font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:var(--ink)}.wrap{max-width:850px;margin:auto;padding:16px}.hero{background:linear-gradient(130deg,#102d50,#245d91);color:white;border-radius:20px;padding:22px;box-shadow:0 8px 28px #18385820}.tag{color:#f5d58a;font-size:12px;letter-spacing:1.4px;font-weight:800}.hero h1{margin:8px 0;font-size:26px}.hero p{margin:0;color:#e2eaf5}.stats{display:flex;gap:8px;margin-top:16px}.stat{background:#ffffff17;border:1px solid #ffffff2b;border-radius:12px;padding:10px;flex:1;text-align:center}.stat b{display:block;font-size:18px}.stat span{font-size:12px;color:#e2eaf5}.panel{background:white;border:1px solid var(--line);border-radius:16px;padding:18px;margin-top:14px}.field{display:block;width:100%;padding:12px;border:1px solid #cbd5e1;border-radius:10px;font:inherit;margin-top:6px}.btn{border:0;border-radius:11px;background:var(--blue);color:white;padding:13px 17px;font-weight:750;font-size:15px;cursor:pointer}.btn.secondary{background:#e8eef6;color:var(--navy)}.btn:disabled{opacity:.5}.topline{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}.progress{height:8px;background:#e8edf4;border-radius:10px;overflow:hidden;margin:14px 0}.progress div{height:100%;width:0;background:var(--gold);transition:width .2s}.qnum{font-size:12px;color:var(--muted);font-weight:800;letter-spacing:1px}.question{font-size:19px;line-height:1.45;font-weight:750;margin:10px 0 16px}.opt{display:flex;gap:10px;align-items:flex-start;border:1px solid var(--line);padding:12px;border-radius:11px;margin:8px 0;cursor:pointer}.opt input{margin-top:4px;accent-color:var(--blue)}.opt:has(input:checked){border-color:var(--blue);background:#eef5fc}.nav{display:flex;gap:8px;justify-content:space-between;margin-top:16px}.nav .btn{flex:1}.small{font-size:13px;color:var(--muted)}.hidden{display:none!important}.score{font-size:42px;font-weight:850;color:var(--navy)}.resultitem{border:1px solid var(--line);border-radius:12px;padding:13px;margin:10px 0}.correct{border-left:5px solid var(--green)}.wrong{border-left:5px solid var(--red)}.badge{display:inline-block;border-radius:999px;padding:4px 9px;font-size:12px;font-weight:800}.good{background:#e3f5eb;color:#176943}.bad{background:#fde9e7;color:#9d241b}.footer{text-align:center;color:var(--muted);font-size:12px;padding:22px}label strong{font-weight:700}@media(min-width:650px){.wrap{padding:24px}.hero{padding:28px}.hero h1{font-size:32px}}
</style></head><body><main class="wrap"><header class="hero"><div class="tag">PRÉPARATION À L’ATTESTATION</div><h1>🇫🇷 AttestFLE — Mock test N° 1</h1><p>Français · QCM · Une seule bonne réponse par question</p><div class="stats"><div class="stat"><b>50</b><span>questions</span></div><div class="stat"><b>100</b><span>points</span></div><div class="stat"><b>60 min</b><span>durée conseillée</span></div></div></header>
<section id="start" class="panel"><h2>Bienvenue !</h2><p>Renseignez votre nom avant de commencer. À la fin, vous verrez votre score sur 100, vos réponses et les bonnes réponses.</p><label>Nom et prénom<input id="fullname" class="field" placeholder="Ex. : Karimova Malika" maxlength="100" required></label><p class="small">Chaque question vaut 2 points. Choisissez une seule réponse par question. Vos réponses restent dans cette session de navigateur.</p><button id="begin" class="btn">Commencer le test →</button></section>
<section id="test" class="panel hidden"><div class="topline"><span id="counter" class="qnum">QUESTION 1 / 50</span><span id="timer" class="badge good">60:00</span></div><div class="progress"><div id="bar"></div></div><div id="qtext" class="question"></div><div id="options"></div><div class="nav"><button id="prev" class="btn secondary">← Précédent</button><button id="next" class="btn">Suivant →</button><button id="finish" class="btn hidden">Terminer le test</button></div><p class="small">Vous pouvez revenir aux questions précédentes avant de terminer.</p></section>
<section id="results" class="panel hidden"><div class="tag" style="color:#9b7628">RÉSULTATS</div><h2 id="resultname">Résultat du candidat</h2><div class="score"><span id="score">0</span><span style="font-size:20px"> / 100</span></div><p id="summary"></p><div class="stats"><div class="stat" style="background:#f0f6f2;color:#176943;border-color:#d6eadf"><b id="correctCount">0</b><span style="color:#176943">Correctes</span></div><div class="stat" style="background:#fff1f0;color:#9d241b;border-color:#f4d8d5"><b id="wrongCount">0</b><span style="color:#9d241b">Incorrectes</span></div><div class="stat" style="background:#f2f4f7;color:#334155;border-color:#e0e5eb"><b id="blankCount">0</b><span style="color:#334155">Sans réponse</span></div></div><button id="copyResult" class="btn" style="margin-top:14px">Copier mon résultat</button> <button id="reviewToggle" class="btn secondary" style="margin-top:14px">Afficher / masquer les réponses</button><div id="review" class="hidden" style="margin-top:16px"></div><p class="small">Conseil : copiez votre résultat si vous souhaitez le conserver. Cette version ne transmet pas automatiquement les notes à l’organisateur.</p></section><div class="footer">AttestFLE · Test d’entraînement original · À vérifier selon le programme officiel applicable</div></main>
<script>
const questions = [{"q": "Si j’avais su que tu venais, je ___ un gâteau.", "o": ["préparerais", "aurais préparé", "avais préparé", "préparerai"], "a": 1, "e": "Avec « si » + plus-que-parfait, on emploie le conditionnel passé dans la principale."}, {"q": "Il faut que les candidats ___ leurs réponses avant la fin de l’épreuve.", "o": ["vérifient", "vérifieront", "vérifiaient", "vérifier"], "a": 0, "e": "Après « il faut que », on utilise le subjonctif."}, {"q": "C’est le professeur ___ les élèves ont parlé pendant la réunion.", "o": ["qui", "que", "dont", "auquel"], "a": 2, "e": "« Parler de quelqu’un » devient « le professeur dont ils ont parlé »."}, {"q": "Les documents que j’ai ___ hier sont sur la table.", "o": ["imprimé", "imprimés", "imprimées", "imprimer"], "a": 1, "e": "Avec avoir, le participe passé s’accorde avec le COD placé avant : les documents."}, {"q": "Elle s’est ___ compte de son erreur trop tard.", "o": ["rendu", "rendue", "rendre", "rendus"], "a": 0, "e": "Dans « se rendre compte », « rendu » reste invariable."}, {"q": "Il travaille dans cette école ___ cinq ans.", "o": ["pendant", "depuis", "en", "il y a"], "a": 1, "e": "« Depuis » exprime une action commencée dans le passé et qui continue."}, {"q": "Je ne pense pas qu’il ___ raison.", "o": ["a", "aura", "ait", "avait eu"], "a": 2, "e": "Le doute après « je ne pense pas que » appelle généralement le subjonctif."}, {"q": "___ tu sois fatigué, tu dois terminer ce travail.", "o": ["Malgré", "Bien que", "À cause de", "Grâce à"], "a": 1, "e": "« Bien que » est suivi du subjonctif."}, {"q": "Les élèves ___ je me suis adressé étaient attentifs.", "o": ["que", "dont", "auxquels", "lesquels"], "a": 2, "e": "On dit « s’adresser à quelqu’un » : auxquels."}, {"q": "Il a réussi l’examen ___ un travail régulier.", "o": ["grâce à", "malgré", "bien que", "au lieu de"], "a": 0, "e": "« Grâce à » introduit une cause positive."}, {"q": "Elle m’a demandé : « Où habites-tu ? » Elle m’a demandé ___.", "o": ["où habites-tu", "où j’habite", "où j’habitais", "où habiter"], "a": 2, "e": "Au discours indirect au passé, « habites-tu » devient « j’habitais »."}, {"q": "Aucun des candidats ne ___ en retard.", "o": ["sont", "soient", "est", "étaient"], "a": 2, "e": "« Aucun » est généralement suivi d’un verbe au singulier."}, {"q": "Il parle français ___ que son frère.", "o": ["meilleur", "mieux", "le mieux", "bien meilleur"], "a": 1, "e": "« Mieux » est le comparatif de l’adverbe « bien »."}, {"q": "À peine ___-il arrivé que le cours a commencé.", "o": ["est", "avait", "fut", "était"], "a": 0, "e": "Dans cette inversion, on dit « À peine est-il arrivé que… »."}, {"q": "Cette décision a été prise ___ le directeur.", "o": ["par", "de", "pour", "chez"], "a": 0, "e": "Le complément d’agent du passif est introduit par « par »."}, {"q": "Le synonyme de « concis » est :", "o": ["Bref", "Confus", "Complexe", "Détaillé"], "a": 0, "e": "« Concis » signifie exprimé en peu de mots."}, {"q": "« Vulgariser un savoir » signifie :", "o": ["Le rendre accessible au grand public", "Le rendre plus scientifique", "Le supprimer d’un programme", "Le traduire littéralement"], "a": 0, "e": "Vulgariser, c’est rendre un contenu accessible à un public non spécialiste."}, {"q": "Une personne « persévérante » est une personne qui :", "o": ["Abandonne facilement", "Continue malgré les difficultés", "Change souvent d’avis", "Refuse toute aide"], "a": 1, "e": "La persévérance consiste à poursuivre ses efforts."}, {"q": "Quel adjectif signifie « qui ne peut pas être vaincu » ?", "o": ["Invincible", "Invisible", "Inévitable", "Instable"], "a": 0, "e": "« Invincible » signifie qu’on ne peut pas le vaincre."}, {"q": "L’expression « mettre en œuvre » signifie :", "o": ["Critiquer", "Reporter", "Appliquer ou réaliser", "Interrompre"], "a": 2, "e": "Mettre en œuvre, c’est appliquer ou réaliser un plan."}, {"q": "Le contraire de « bienveillant » est :", "o": ["Attentionné", "Malveillant", "Généreux", "Tolérant"], "a": 1, "e": "« Malveillant » exprime une intention nuisible."}, {"q": "Un « enjeu pédagogique » désigne :", "o": ["Un problème d’orthographe uniquement", "Ce qui est important dans une situation d’enseignement", "Une punition scolaire", "Un matériel informatique"], "a": 1, "e": "Un enjeu est ce qui est important ou ce qui peut être gagné/perdu."}, {"q": "« Il a éludé la question » signifie qu’il a :", "o": ["Répondu précisément", "Répété la question", "Évité d’y répondre directement", "Corrigé la question"], "a": 2, "e": "Éluder une question, c’est éviter d’y répondre franchement."}, {"q": "Quel mot désigne une affirmation qui contredit une autre affirmation ?", "o": ["Une contradiction", "Une reformulation", "Une précision", "Une concession"], "a": 0, "e": "Une contradiction oppose deux affirmations incompatibles."}, {"q": "Un « emballage superflu » est un emballage :", "o": ["Indispensable", "Inutile ou excessif", "Biodégradable", "Réutilisable"], "a": 1, "e": "« Superflu » signifie inutile ou qui dépasse le nécessaire."}, {"q": "Quel est le thème principal du texte sur le numérique éducatif ?", "o": ["Les dangers d’Internet pour les familles", "L’utilisation du numérique dans l’éducation", "La disparition du métier d’enseignant", "Les examens traditionnels"], "a": 1, "e": "Le texte présente les avantages et les limites du numérique dans l’éducation."}, {"q": "Les plateformes éducatives permettent notamment de :", "o": ["Supprimer les devoirs", "Remplacer les enseignants", "Suivre les progrès des apprenants", "Garantir la réussite de tous"], "a": 2, "e": "Le texte indique qu’elles facilitent le suivi des progrès."}, {"q": "Pourquoi le numérique peut-il accentuer certaines inégalités ?", "o": ["Tous les enseignants refusent son utilisation", "Certains élèves manquent d’accès à Internet ou d’équipement", "Les manuels sont trop nombreux", "Les familles ne communiquent jamais"], "a": 1, "e": "L’accès au réseau et aux appareils n’est pas égal pour tous."}, {"q": "« Tirer profit de ces outils » signifie :", "o": ["Les vendre", "Les utiliser de manière avantageuse", "Les éviter systématiquement", "Les remplacer par des livres"], "a": 1, "e": "Tirer profit signifie bénéficier de quelque chose."}, {"q": "Quel risque est associé à une utilisation excessive des écrans ?", "o": ["Une meilleure mémorisation systématique", "Une augmentation garantie de l’autonomie", "Une diminution de la concentration", "Une réussite assurée"], "a": 2, "e": "Le texte souligne que les écrans peuvent nuire à la concentration."}, {"q": "Pourquoi la formation des enseignants est-elle essentielle ?", "o": ["Pour choisir et utiliser les outils efficacement", "Pour supprimer les objectifs pédagogiques", "Pour réduire les échanges", "Pour rendre tous les cours numériques"], "a": 0, "e": "La formation développe les compétences numériques et le choix raisonné des ressources."}, {"q": "Quelle est la position de l’auteur concernant le numérique ?", "o": ["Il doit remplacer entièrement le professeur", "Il est toujours nuisible", "Il est utile s’il est employé de façon réfléchie", "Il ne présente aucun avantage"], "a": 2, "e": "Le numérique est présenté comme un moyen complémentaire."}, {"q": "Le mot « cependant » exprime :", "o": ["La cause", "L’opposition", "La conséquence", "Le but"], "a": 1, "e": "« Cependant » marque une opposition ou une concession."}, {"q": "Un collègue vous demande poliment de lui envoyer les documents. Quelle réponse convient le mieux ?", "o": ["Tu n’as qu’à les chercher.", "Je vous les enverrai cet après-midi.", "Ce n’est pas mon problème.", "Vous auriez dû les demander avant."], "a": 1, "e": "Cette réponse est polie, claire et adaptée au contexte professionnel."}, {"q": "Vous souhaitez exprimer une réserve avec diplomatie. Quelle formulation choisissez-vous ?", "o": ["Votre idée est absurde.", "Vous avez tort, c’est évident.", "Je comprends votre point de vue, mais j’aimerais apporter une nuance.", "Je refuse d’écouter votre proposition."], "a": 2, "e": "La formulation reconnaît le point de vue de l’autre tout en nuançant."}, {"q": "Un élève ne comprend pas une consigne. Quelle intervention favorise son apprentissage ?", "o": ["Tu n’écoutes jamais !", "Relis sans poser de questions.", "Essayons de reformuler la consigne ensemble.", "Passe à l’exercice suivant."], "a": 2, "e": "La reformulation guidée aide l’élève à comprendre la tâche."}, {"q": "Vous voulez interrompre poliment un intervenant pour demander une précision.", "o": ["Taisez-vous !", "Excusez-moi, pourrais-je vous demander une précision ?", "Vous n’êtes pas clair.", "Je ne suis pas d’accord avec tout."], "a": 1, "e": "Cette formule est respectueuse et adaptée à une réunion."}, {"q": "Quelle expression introduit une concession ?", "o": ["Par conséquent", "En raison de", "Bien que", "Afin de"], "a": 2, "e": "« Bien que » introduit une concession et est suivi du subjonctif."}, {"q": "Un apprenant dit qu’il a beaucoup travaillé mais n’a pas réussi. Quelle réponse est constructive ?", "o": ["Tu n’es pas fait pour cette matière.", "Tes efforts sont inutiles.", "Identifions ensemble les difficultés pour progresser.", "Il fallait travailler davantage, c’est tout."], "a": 2, "e": "La réponse encourage l’analyse des difficultés et la progression."}, {"q": "Selon l’approche actionnelle du CECR, l’apprenant est principalement considéré comme :", "o": ["Un simple récepteur de règles", "Un acteur social qui accomplit des tâches", "Un observateur passif", "Un traducteur permanent"], "a": 1, "e": "L’approche actionnelle considère l’apprenant comme un acteur social."}, {"q": "Quel est l’objectif principal de l’évaluation formative ?", "o": ["Classer définitivement les élèves", "Accompagner les apprentissages et ajuster l’enseignement", "Remplacer les activités de classe", "Attribuer uniquement une note finale"], "a": 1, "e": "L’évaluation formative aide à réguler l’apprentissage et l’enseignement."}, {"q": "Pour travailler la compréhension orale, quelle activité est la plus pertinente ?", "o": ["Copier une liste de verbes sans contexte", "Écouter un dialogue et identifier les informations essentielles", "Traduire un texte écrit sans l’écouter", "Apprendre uniquement l’orthographe"], "a": 1, "e": "La compréhension orale s’entraîne par l’écoute et l’identification d’informations."}, {"q": "Un objectif pédagogique bien formulé doit être :", "o": ["Impossible à vérifier", "Adapté au niveau et observable", "Identique pour toutes les classes sans adaptation", "Centré uniquement sur le manuel"], "a": 1, "e": "Un objectif utile doit être adapté et observable/évaluable."}, {"q": "La différenciation pédagogique consiste à :", "o": ["Donner exactement le même soutien à tous", "Réduire les objectifs pour tous", "Adapter les démarches et les aides aux besoins", "Évaluer uniquement les meilleurs"], "a": 2, "e": "La différenciation prend en compte les besoins et les profils des apprenants."}, {"q": "Quelle démarche favorise le mieux l’autonomie des apprenants ?", "o": ["Donner toutes les réponses d’avance", "Interdire l’autoévaluation", "Proposer des stratégies, des critères de réussite et l’autoévaluation", "Corriger sans laisser réfléchir"], "a": 2, "e": "Les stratégies et l’autoévaluation aident l’apprenant à devenir autonome."}, {"q": "Quel document décrit généralement les niveaux de compétence en langues en Europe ?", "o": ["Le CECR", "Le règlement intérieur", "Le registre d’appel", "Le cahier de textes"], "a": 0, "e": "Le CECR est le Cadre européen commun de référence pour les langues."}, {"q": "Dans une tâche communicative, la priorité est de :", "o": ["Réciter toutes les règles sans contexte", "Utiliser la langue pour atteindre un objectif de communication", "Éviter toute interaction", "Traduire chaque mot séparément"], "a": 1, "e": "Une tâche communicative mobilise la langue pour accomplir un objectif."}, {"q": "Quelle activité développe le mieux l’interaction orale ?", "o": ["Lire silencieusement seul", "Mémoriser une liste sans échange", "Jouer une scène à deux avec un objectif précis", "Copier un paragraphe"], "a": 2, "e": "Le jeu de rôle implique échange, écoute et réponse à un interlocuteur."}, {"q": "À quoi sert principalement une grille d’évaluation ?", "o": ["À rendre les critères de réussite explicites", "À remplacer les consignes", "À empêcher les retours aux élèves", "À noter sans critères"], "a": 0, "e": "Une grille explicite les critères et aide à évaluer de façon cohérente."}, {"q": "Un élève fait une erreur récurrente. Quelle démarche est la plus adaptée ?", "o": ["L’ignorer toujours", "Le punir systématiquement", "Analyser l’erreur et proposer une activité ciblée", "Lui interdire de parler"], "a": 2, "e": "L’erreur peut révéler un besoin et guider une remédiation ciblée."}];
let idx=0, answers=Array(questions.length).fill(null), started=false, ended=false, remaining=3600, timerId=null, candidate='';
const $=id=>document.getElementById(id);
function show(id){['start','test','results'].forEach(x=>$(x).classList.toggle('hidden',x!==id));}
function render(){const q=questions[idx];$('counter').textContent=`QUESTION ${idx+1} / ${questions.length}`;$('bar').style.width=`${(idx+1)/questions.length*100}%`;$('qtext').textContent=q.q;$('options').innerHTML='';q.o.forEach((o,j)=>{const lab=document.createElement('label');lab.className='opt';const inp=document.createElement('input');inp.type='radio';inp.name='answer';inp.checked=answers[idx]===j;inp.addEventListener('change',()=>{answers[idx]=j;});const span=document.createElement('span');span.textContent=String.fromCharCode(65+j)+'. '+o;lab.append(inp,span);$('options').append(lab)});$('prev').disabled=idx===0;$('next').classList.toggle('hidden',idx===questions.length-1);$('finish').classList.toggle('hidden',idx!==questions.length-1);}
function tick(){remaining--;if(remaining<0)remaining=0;const m=String(Math.floor(remaining/60)).padStart(2,'0'),s=String(remaining%60).padStart(2,'0');$('timer').textContent=`${m}:${s}`;if(remaining<=300)$('timer').className='badge bad';if(remaining===0)finishTest();}
$('begin').addEventListener('click',()=>{candidate=$('fullname').value.trim();if(!candidate){alert('Veuillez saisir votre nom et prénom.');return}started=true;show('test');render();timerId=setInterval(tick,1000)});
$('prev').addEventListener('click',()=>{if(idx>0){idx--;render()}});$('next').addEventListener('click',()=>{if(idx<questions.length-1){idx++;render()}});$('finish').addEventListener('click',()=>{const blank=answers.filter(x=>x===null).length;if(blank>0&&!confirm(`Il reste ${blank} question(s) sans réponse. Terminer quand même ?`))return;finishTest()});
function finishTest(){if(ended)return;ended=true;if(timerId)clearInterval(timerId);let correct=0;questions.forEach((q,i)=>{if(answers[i]===q.a)correct++});const wrong=answers.filter((a,i)=>a!==null&&a!==questions[i].a).length,blank=answers.filter(a=>a===null).length,score=correct*2;$('resultname').textContent=candidate;$('score').textContent=score;$('correctCount').textContent=correct;$('wrongCount').textContent=wrong;$('blankCount').textContent=blank;$('summary').textContent=`${candidate}, vous avez obtenu ${score}/100 (${correct}/50 bonnes réponses).`;const review=$('review');review.innerHTML='';questions.forEach((q,i)=>{const ok=answers[i]===q.a;const card=document.createElement('div');card.className='resultitem '+(ok?'correct':'wrong');const h=document.createElement('div');h.innerHTML=`<strong>${i+1}. ${q.q}</strong> <span class="badge ${ok?'good':'bad'}">${answers[i]===null?'Sans réponse':ok?'Correct':'Incorrect'}</span>`;const yours=document.createElement('p');yours.textContent='Votre réponse : '+(answers[i]===null?'Aucune réponse':String.fromCharCode(65+answers[i])+'. '+q.o[answers[i]]);const right=document.createElement('p');right.innerHTML='<strong>Bonne réponse : '+String.fromCharCode(65+q.a)+'. '+q.o[q.a]+'</strong>';const expl=document.createElement('p');expl.className='small';expl.textContent=q.e;card.append(h,yours,right,expl);review.append(card)});show('results');}
$('reviewToggle').addEventListener('click',()=>$('review').classList.toggle('hidden'));
$('copyResult').addEventListener('click',async()=>{const text=`AttestFLE — Mock test N° 1\nNom : ${candidate}\nRésultat : ${$('score').textContent}/100\nBonnes réponses : ${$('correctCount').textContent}/50\nIncorrectes : ${$('wrongCount').textContent}\nSans réponse : ${$('blankCount').textContent}`;try{await navigator.clipboard.writeText(text);alert('Résultat copié !')}catch(e){prompt('Copiez votre résultat :',text)}});
</script></body></html>
